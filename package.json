{
  "name": "hpd-bid-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prebuild": "node scripts/import-saved-job-statuses.cjs --write",
    "test:saved-statuses": "node scripts/test-saved-job-statuses.cjs",
    "postinstall": "node scripts/prepare-map-worker.cjs",
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "node scripts/build-cloudflare-pages.js",
    "verify:paperwork-data": "node scripts/verify-paperwork-data.js --strict",
    "test:cloudflare-worker": "node cloudflare-worker/test-sync.mjs",
